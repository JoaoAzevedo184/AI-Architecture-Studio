{
  "name": "arquitecture",
  "version": "0.1.0",
  "description": "Editor local de arquitetura de software: modelo em docs/architecture.json e canvas com drill-down",
  "type": "module",
  "bin": {
    "arquitecture": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:package": "vitest run --config vitest.package.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "ajv": "^8.20.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
